# HTX-3D — machine-specific configuration
#
# Copy to `.env` in this directory and edit for your machine:
#     cp docker/.env.example docker/.env
#
# Docker Compose loads `docker/.env` automatically when run from this directory.
# `.env` is gitignored; this example file is committed.
#
# ---------------------------------------------------------------------------
# SCOPE — read before adding anything here.
#
# This file covers ONLY values that differ from one machine to the next: where
# model weights and caches live on the host, and how to reach the TRELLIS.2
# service.
#
# Container-internal paths — WEIGHTS_DIR, GALLERY_DIR, TRELLIS_ENGINE_DIR,
# HUNYUAN_ENGINE_DIR, SAM3_DIR, SAM3D_OBJECTS_DIR, SAM3_BPE_PATH, CORS_ORIGINS,
# XFORMERS_DISABLED, ATTN_BACKEND and PYTORCH_CUDA_ALLOC_CONF — are DELIBERATELY
# fixed in docker-compose.yml. They describe the layout inside the image, not
# your machine. They are not missing from this file; they do not belong here,
# and moving them here will break the container.
# ---------------------------------------------------------------------------


# === Model weights and gallery storage ======================================
#
# Both default to sitting beside the repo (../weights, ../gallery). Override them
# to put the data on a larger volume — these are the two directories that grow.
#
#   weights: ~5.3 GB of TRELLIS models
#   gallery: unbounded — one directory per generation, GLB + preview + thumbnail.
#            It reached 14 GB over ~800 generations during development.
#
# Relative paths resolve against this directory (docker/), not the repo root.
# WEIGHTS_HOST_DIR=../weights
# GALLERY_HOST_DIR=../gallery


# === SAM 3D Objects weights =================================================
#
# >>> THIS ALMOST CERTAINLY NEEDS SETTING. <<<
#
# The default below assumes the weights live in-repo at weights/sam3d-objects-hf.
# That default is UNTESTED: on the development machine that directory is empty
# and the real weights sit elsewhere, so nobody has ever run the stack with the
# weights actually at the default path.
#
# If it is wrong, the SAM 3D engine fails at first use with a FileNotFoundError
# listing every path it searched. Read that list — it tells you exactly where it
# looked. The other five engines are unaffected.
#
# This is the HOST directory that docker-compose.yml bind-mounts. It is read on
# the host at `up` time and is NOT passed into the container.
SAM3D_HF_DIR=../weights/sam3d-objects-hf

# --- SAM3D_HF_DIR vs SAM3D_HF_PATH — NOT interchangeable --------------------
#
#   SAM3D_HF_DIR   Read by docker-compose.yml, on the HOST. The bind-mount
#                  SOURCE. This is the one you almost certainly want.
#
#   SAM3D_HF_PATH  Read by the BACKEND (backend/app/config.py). An extra
#                  location to search for pipeline.yaml. Only meaningful when
#                  running the backend OUTSIDE the container — inside it, the
#                  compose mount already delivers the weights to
#                  /app/weights/sam3d-objects-hf and this is not needed.
#
# Most operators set SAM3D_HF_DIR only, and leave SAM3D_HF_PATH empty.
# SAM3D_HF_PATH=


# === Host cache directories =================================================
#
# Mounted into the container so large downloads survive rebuilds. The defaults
# follow the standard per-user locations and are correct on most machines —
# override only if your caches live elsewhere (e.g. on a larger volume).
#
# HF_CACHE_DIR=${HOME}/.cache/huggingface     # HuggingFace: SAM 3, DINOv3, etc.
# TORCH_CACHE_DIR=${HOME}/.cache/torch        # torch hub: DINOv2 weights, ~1.1 GB
# HY3DGEN_CACHE_DIR=${HOME}/.cache/hy3dgen    # Hunyuan3D model cache
# U2NET_CACHE_DIR=${HOME}/.u2net              # rembg background-removal model


# === TRELLIS.2 host service =================================================
#
# TRELLIS.2 runs on the HOST, not in the container — it needs the host's
# sm_120 torch/FlashAttention-2 stack. See services/trellis2/README.md for
# how to deploy it.
#
#   In the container (default):  http://host.docker.internal:8710
#                                Resolves only because docker-compose.yml maps
#                                it to the host gateway via `extra_hosts`.
#                                Do not remove that entry.
#
#   Backend outside a container: http://localhost:8710
#
# TRELLIS2_SERVICE_URL=http://host.docker.internal:8710

# Timeout in seconds for the NON-FATAL reachability check the backend runs at
# startup. Short on purpose: it only has to distinguish "running" from "not
# running", and a wrong URL that blackholes packets would otherwise stall every
# backend start while TRELLIS.2 is not yet deployed. The actual load path uses
# its own longer timeout and is unaffected by this.
# TRELLIS2_PROBE_TIMEOUT=2
